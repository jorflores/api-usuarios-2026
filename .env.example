# Copia este archivo como .env y llena tus valores.

# Local: tu PostgreSQL. Desde tu compu hacia Render: la External Database URL + ?sslmode=no-verify
DATABASE_URL="postgresql://usuario:password@localhost:5432/api_usuarios?sslmode=no-verify"

# Cualquier texto largo y secreto. En Render va en Environment.
JWT_SECRET="cambia-esto-por-un-texto-largo-y-secreto"

# Admin inicial que crea `npm run seed`
ADMIN_CORREO="admin@mail.com"
ADMIN_PASSWORD="1234"
